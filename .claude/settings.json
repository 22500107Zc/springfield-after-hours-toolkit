{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npx vitest run:*)",
      "Bash(node packages/cli/dist/bin.js:*)",
      "Bash(node scripts/research/derive-command-registry.mjs --check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Write(./data/registries/commands.yaml)",
      "Write(./data/registries/characters.yaml)",
      "Write(./vendor/**)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["springfield-after-hours-toolkit"]
}

# Dependencies
node_modules/

# Build output.
#
# These are anchored on purpose. A bare `dist/` matches at every depth, and it
# once silently swallowed the packaging scripts that build the release
# binaries — the release workflow then failed on a commit that looked complete.
# Ignore the directories the compiler actually writes, and nothing else.
/dist/
packages/*/dist/
build/
*.tsbuildinfo

# Test output
coverage/
.vitest/

# Secrets and local configuration — never commit these
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
sah.local.json
sah.config.local.json
.sah/

# Logs (may contain prompts, paths or credentials)
logs/
*.log
npm-debug.log*
prompts/*.log

# Third-party sources fetched on demand.
# These are NOT redistributed by this repository.
vendor/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
*.swp

# Standalone-binary build output
dist-bundle/

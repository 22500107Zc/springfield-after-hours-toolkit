# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. Never commit real credentials.
#
# EVERY value here is OPTIONAL. The toolkit's core features
# (init, validate, build, package, registry, MCP server) work
# without any of them.

# ---------------------------------------------------------------------------
# Optional: direct Anthropic API integration (`sah ai ...`)
# ---------------------------------------------------------------------------
# Only needed for the `sah ai` subcommands. Using these WILL incur API charges
# on your Anthropic account. Claude Code itself does NOT need this key — it
# uses your normal Claude authentication.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to the value in your sah config.
# SAH_ANTHROPIC_MODEL=claude-sonnet-5

# Optional hard ceiling on tokens the AI package may request in one command.
# SAH_AI_MAX_OUTPUT_TOKENS=4096

# Optional per-command spending safeguard, in USD. The AI package refuses to
# run a command whose estimated cost exceeds this.
# SAH_AI_MAX_COST_USD=0.50

# ---------------------------------------------------------------------------
# Optional: local paths (see also `sah config`)
# ---------------------------------------------------------------------------
# These are only used to report environment status in `sah doctor`. The
# toolkit never writes to your game installation.
# SAH_GAME_PATH=
# SAH_MOD_LAUNCHER_PATH=
# SAH_MODS_DIRECTORY=
# SAH_CONNECTED_MAP_PATH=

# Optional extra registry directory (adds to the built-in registries).
# SAH_REGISTRY_DIR=
